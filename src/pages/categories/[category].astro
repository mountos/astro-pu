
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const catMap = new Map();
  for (const post of posts) {
    for (const rawCat of (post.data.categories || [])) {
      if (!rawCat) continue;
      const slug = rawCat.toLowerCase();
      if (!catMap.has(slug)) {
        catMap.set(slug, {
          slug,
          displayName: rawCat,
          postCounts: new Map(),
          posts: new Set(),
        });
      }
      const entry = catMap.get(slug);
      entry.posts.add(post);
      entry.postCounts.set(rawCat, (entry.postCounts.get(rawCat) || 0) + 1);
    }
  }

  return Array.from(catMap.values()).map(entry => {
    let bestName = entry.displayName;
    let maxCount = 0;
    for (const [name, count] of entry.postCounts.entries()) {
      if (count > maxCount || (count === maxCount && /[A-Z]/.test(name) && !/[A-Z]/.test(bestName))) {
        bestName = name;
        maxCount = count;
      }
    }

    const filteredPosts = Array.from(entry.posts);
    return {
      params: { category: entry.slug },
      props: { posts: filteredPosts, displayName: bestName },
    };
  });
}

const { category } = Astro.params;
const { posts, displayName } = Astro.props;
const displayCategory = displayName || category;
---
<Layout title={`Category: ${displayCategory}`}>
  <section class="post-list">
    <h2>Category: {displayCategory}</h2>
    <ul>
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}/`}>
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">{new Date(post.data.pubDate).toLocaleDateString('en-US')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
	.post-list h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid #eee;
		padding-bottom: 1rem;
	}
	.post-list ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem;
		border-radius: 8px;
		text-decoration: none;
		color: #333;
		transition: all 0.2s ease;
		margin-bottom: 0.5rem;
	}
	.post-list li a:hover {
		background-color: var(--color-primary-light);
		color: var(--color-primary-dark);
		transform: translateX(4px);
	}
	.post-title {
		font-size: 1.2rem;
		font-weight: 500;
	}
	.post-date {
		font-size: 0.9rem;
		color: #888;
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 1024px) {
		.post-list h2 {
			font-size: 2.25rem;
			margin-bottom: 2.5rem;
		}
		.post-list li a {
			padding: 1.25rem 1.5rem;
			border-radius: 10px;
		}
		.post-title {
			font-size: 1.25rem;
		}
		.post-date {
			font-size: 0.95rem;
		}
	}
</style>
