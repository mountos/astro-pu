---
import { getCollection } from 'astro:content';
import { LANG_PREFIX, useTranslations, type Lang } from '../utils/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'zh-tw' } = Astro.props;
const t = useTranslations(lang);
const prefix = LANG_PREFIX[lang];

const posts = await getCollection('blog');
const langPosts = posts.filter(post => (post.data.lang || 'zh-tw') === lang);
const allCategories = (langPosts.length > 0 ? langPosts : posts).flatMap(post => post.data.categories);
const uniqueCategories = [...new Set(allCategories)];

const today = new Date();
const aboutUrl = `${prefix}/about/`;
const contactUrl = `${prefix}/contact/`;
const privacyUrl = `${prefix}/privacy/`;
const searchUrl = `${prefix}/search/`;
---
<footer>
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-intro">
        <h3>
          <img src="/images/Mountos-Logo.png" alt="Mountos Logo" width="32" height="32" class="footer-logo" />
          {t('siteTitle')}
        </h3>
        <p>{t('siteDescription')}</p>
      </div>
      <div class="footer-menus">
        <div class="footer-menu">
          <h4>{t('categories')}</h4>
          <ul>
            {uniqueCategories.slice(0, 5).map(category => (
              <li><a href={`${prefix}/categories/${encodeURIComponent(category)}/`}>{category}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-menu">
          <h4>{t('siteInfo')}</h4>
          <ul>
            <li><a href={aboutUrl}>{t('aboutUs')}</a></li>
            <li><a href={contactUrl}>{t('contactUs')}</a></li>
            <li><a href={privacyUrl}>{t('privacyPolicy')}</a></li>
            <li><a href={searchUrl}>{t('siteSearch')}</a></li>
          </ul>
        </div>
        <div class="footer-menu">
          <h4>{t('supportUs')}</h4>
          <ul>
            <li><a href="https://buymeacoffee.com/mountos" rel="nofollow noopener noreferrer" target="_blank">{t('donate')}</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {today.getFullYear()} {t('siteTitle')}. Powered by <a href="https://mountos.com/" target="_blank" rel="noopener noreferrer">Mountos</a>.
      </p>
    </div>
  </div>
</footer>
