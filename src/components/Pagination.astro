---
import type { Page } from 'astro';
import { useTranslations, type Lang } from '../utils/i18n';

export interface Props {
  page: Page;
  lang?: Lang;
}

const { page, lang = 'zh-tw' } = Astro.props;
const t = useTranslations(lang);
---
<nav class="pagination" aria-label="Pagination Navigation">
  <div class="nav-links">
    {page.url.prev ? (
      <a href={page.url.prev} class="nav-link prev">
        &larr; {t('prevPage')}
      </a>
    ) : (
      <span class="nav-link disabled">&larr; {t('prevPage')}</span>
    )}

    <span class="page-indicator">
      {t('page', { page: page.currentPage })} / {page.lastPage}
    </span>

    {page.url.next ? (
      <a href={page.url.next} class="nav-link next">
        {t('nextPage')} &rarr;
      </a>
    ) : (
      <span class="nav-link disabled">{t('nextPage')} &rarr;</span>
    )}
  </div>
</nav>

<style>
  .pagination {
    margin-top: 3rem;
    text-align: center;
  }
  .nav-links {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 8px;
    overflow: hidden;
  }
  .nav-link, .page-indicator {
    padding: 0.75rem 1.25rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1;
  }
  .nav-link:not(.disabled) {
    transition: background-color 0.2s ease;
  }
  .nav-link:not(.disabled):hover {
    background-color: var(--hover-bg, #f3f4f6);
  }
  .nav-link.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
