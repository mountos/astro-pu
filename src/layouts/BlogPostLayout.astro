---
import Layout from './Layout.astro';
import ToC from '../components/ToC.astro';
import { LANG_PREFIX, useTranslations, type Lang } from '../utils/i18n';
import { getPostHeroImage } from '../utils/post';

interface Props {
  frontmatter: any;
  headings: any[];
  lang?: Lang;
  alternates?: Record<string, string>;
  post?: any;
}

const { frontmatter, headings, lang = 'zh-tw', alternates, post } = Astro.props;
const t = useTranslations(lang);
const prefix = LANG_PREFIX[lang];

const hasHeadings = headings.filter(h => h.depth > 1 && h.depth < 4).length > 0;
const primaryCategory = frontmatter.categories?.[0];
const heroImg = post ? getPostHeroImage(post) : (frontmatter.heroImage ? frontmatter.heroImage.replace(/^\.\//, '') : '');

const dateLocale = lang === 'en' ? 'en-US' : (lang === 'ja' ? 'ja-JP' : (lang === 'sc' ? 'zh-CN' : 'zh-TW'));
---
<Layout 
  title={`${frontmatter.title}`} 
  description={frontmatter.description}
  type="article"
  lang={lang}
  alternates={alternates}
  image={heroImg}
  article={{
    publishedTime: new Date(frontmatter.pubDate).toISOString(),
    modifiedTime: frontmatter.updatedDate ? new Date(frontmatter.updatedDate).toISOString() : undefined,
    tags: frontmatter.tags,
    author: frontmatter.author || 'Mountos',
  }}
>

  {heroImg &&
    <div slot="hero" class="hero-background-container">
      <div class="hero-image" style={`background-image: url(${heroImg})`}></div>
      <div class="hero-overlay"></div>
    </div>
  }

  <div class="hero-foreground-content">
    {primaryCategory && (
      <a href={`${prefix}/categories/${encodeURIComponent(primaryCategory)}/`} class="hero-category">
        {primaryCategory}
      </a>
    )}
    <h1 class="hero-title">{frontmatter.title}</h1>
  </div>

  <div class="blog-container">
    <article class="post" itemscope itemtype="http://schema.org/BlogPosting">
      <div class="post-meta-bar">
        <div class="meta-item">
          <span class="label">{t('postedOn')}</span>
          <span class="value">{new Date(frontmatter.pubDate).toLocaleDateString(dateLocale)}</span>
        </div>
        {frontmatter.updatedDate && (
          <div class="meta-item">
            <span class="label">{t('updatedOn')}</span>
            <span class="value">{new Date(frontmatter.updatedDate).toLocaleDateString(dateLocale)}</span>
          </div>
        )}
      </div>

      <div class="content" itemprop="articleBody">
        <slot />
      </div>

      {frontmatter.tags?.length > 0 &&
        <footer class="post-footer">
          <div class="tags-list">
            <span>{t('tags')}</span>
            {frontmatter.tags.map((tag: string) => (
              <a href={`${prefix}/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))}
          </div>
        </footer>
      }
    </article>
    
    {hasHeadings &&
      <aside class="toc-container">
        <ToC headings={headings} />
      </aside>
    }
  </div>
</Layout>

<style>
  :global(.main-content) {
    padding: 0 !important;
    max-width: none !important;
    width: 100% !important;
  }
  .hero-category {
    color: var(--primary-color, #2563eb);
    text-decoration: none;
    font-weight: 600;
  }
</style>
